# Copy with: python scripts/setup_env.py
# This template is safe to commit. backend/.env is private and ignored by Git.
ENVIRONMENT=development
# Core API database: AWS RDS for PostgreSQL (see AWS_RDS.md). URL-encode special characters
# in the password (@ -> %40, : -> %3A, / -> %2F). Mock institutions keep their own SQLite files.
# DATABASE_URL=postgresql+psycopg://capital_admin:PASSWORD@your-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/capital_insight
# RDS hosts default to sslmode=require. For certificate verification, download
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem to backend/certs/ and set:
# DATABASE_SSLMODE=verify-full
# DATABASE_SSLROOTCERT=certs/global-bundle.pem
# Local-only fallback when no PostgreSQL is configured:
DATABASE_URL=sqlite:///./data/capital_insight.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# setup_env.py fills this with a new Fernet key. Keep it stable for saved connections.
ENCRYPTION_KEY=
SESSION_TTL_SECONDS=86400
REQUEST_TIMEOUT_SECONDS=15
CORS_ORIGINS=["http://localhost:3000"]
MOCK_SERVICE_URLS={"chase":"http://localhost:8001","amex":"http://localhost:8002","pnc":"http://localhost:8003","discover":"http://localhost:8004","loans":"http://localhost:8005","mortgages":"http://localhost:8006"}

# Optional: get a client ID and Sandbox secret from https://dashboard.plaid.com/
# Keep both values on the backend. Never prefix secrets with NEXT_PUBLIC_.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_PRODUCTS=["transactions"]
PLAID_COUNTRY_CODES=["US"]
# Optional; use an exact redirect URI registered in your Plaid Dashboard.
PLAID_REDIRECT_URI=

# Frontend-compatible /api/v1 adapter settings. Individual URLs override the
# corresponding MOCK_SERVICE_URLS entry when explicitly configured.
# CHASE_URL=http://localhost:8001
# AMEX_URL=http://localhost:8002
# PNC_URL=http://localhost:8003
# DISCOVER_URL=http://localhost:8004
# LOANS_URL=http://localhost:8005
# MORTGAGES_URL=http://localhost:8006
MAX_SESSIONS=10000
UPSTREAM_TIMEOUT_SECONDS=10

# Sam (NVIDIA Nemotron) - optional. Paste your key from https://build.nvidia.com/ into
# backend/.env (never this template, never the frontend, never NEXT_PUBLIC_*).
# Without a key, goals, forecasts and calculators still work; Sam shows a setup notice.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_MAX_TOKENS=2500
# Reasoning traces are never shown to users; enabling thinking only adds latency here.
NVIDIA_ENABLE_THINKING=false
