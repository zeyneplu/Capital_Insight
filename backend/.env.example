# Copy to .env (never commit .env). Every value has a safe default for local dev.

# fixtures = offline demo personas | nessie = live Capital One sandbox
DATA_SOURCE=fixtures

# Partner banks (mock-bank instances). These are the URLs when you run the banks
# with uvicorn on your laptop; docker-compose overrides them with service names.
BANKS={"pecan": {"name": "Pecan Bank (demo)", "base_url": "http://localhost:9001"}, "comet": {"name": "Comet Card (demo)", "base_url": "http://localhost:9002"}}

# Postgres for users, linked banks, goals (used once persistence is added; see the plan).
DATABASE_URL=postgresql+psycopg://capital:capital-dev-only@localhost:5432/capital_insight

# Capital One Nessie (GET only): confirm the base URL in the Nessie portal.
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
NESSIE_API_KEY=

# NVIDIA Nemotron. Hosted: key from build.nvidia.com (nvapi-...).
# Self-hosted NIM on Brev: NVIDIA_BASE_URL=http://localhost:8001/v1 and NVIDIA_API_KEY=not-used
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# Copy the exact model ID from the model card on build.nvidia.com.
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

CORS_ORIGINS=["http://localhost:3000"]
