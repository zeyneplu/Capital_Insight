# Copy to backend/.env. Upstream service URLs (defaults match the services' documented ports).
CHASE_URL=http://localhost:8001
AMEX_URL=http://localhost:8002
PNC_URL=http://localhost:8003
DISCOVER_URL=http://localhost:8004
LOANS_URL=http://localhost:8005
MORTGAGES_URL=http://localhost:8006
# Idle sessions (and the bank tokens they hold) are dropped after this many seconds.
SESSION_TTL_SECONDS=3600
