# Copy to .env.local (never commit .env.local). Everything here is optional:
# with no file at all the app uses deterministic demo fixtures.

# "mock" (default) = fixtures; "http" = Capital Insight core API (fails loudly instead of
# falling back to demo data). Sign-in, Plan & goals and Sam require "http".
DATA_SOURCE=mock

# Server-side only. Never prefix with NEXT_PUBLIC_.
# BACKEND_API_URL=http://localhost:8000

# NVIDIA_API_KEY does NOT belong in the frontend. Sam calls Nemotron from the backend:
# set NVIDIA_API_KEY=nvapi-... in backend/.env.

# Development aid: artificial delay (ms, max 5000) in the fixture provider to see loading states.
# MOCK_LATENCY_MS=800
