# Copy to .env for local runs. In docker-compose / AWS these come from the service config.
BANK_ID=pecan
BANK_NAME=Pecan Bank (demo)
SEED=42
HISTORY_DAYS=90

# Default: data/<BANK_ID>.db (SQLite). Any SQLAlchemy URL works, e.g. Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/pecan
# DATABASE_URL=

# Required to be a long random value when DEV_MODE=false:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BANK_SECRET=dev-only-change-me
DEV_MODE=true

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
TOKEN_TTL_MINUTES=1440
