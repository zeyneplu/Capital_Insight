# Gmail SMTP for fictional customer verification codes.
# Change to smtp only after filling ALL fields below; log preserves local demos.
AUTH_CODE_DELIVERY=log
# customer: each institution emails its own database customer; no shared API key needed.
# forwarded_demo: optional legacy demo that allows key-protected recipient forwarding.
MOCK_EMAIL_RECIPIENT_MODE=customer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
# Use a Google app password (without spaces), not your normal Gmail password.
SMTP_PASSWORD=
SMTP_FROM=
# Real inbox receiving codes for synthetic customerN@*.example.test identities.
AUTH_EMAIL_RECIPIENT=
SMTP_TIMEOUT_SECONDS=10

# Shared only by backend and mock services; generate a random value locally.
MOCK_SERVICE_API_KEY=
